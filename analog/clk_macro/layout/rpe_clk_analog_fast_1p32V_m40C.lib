	pin(trim4) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim5) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim6) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim7) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(clk) {
		direction : output ;
		capacitance : 0.0 ;
		max_capacitance : 0.300 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
		internal_power() {
			rise_power("scalar") { values ("2.2748") ; }
			fall_power("scalar") { values ("2.2748") ; }
		}
		timing() {
			related_pin : "en_ring" ;
			timing_sense : positive_unate ;
			cell_rise(delay_template_5x5) {
				values ( \
					"0.1333, 0.1382, 0.1505, 0.1811, 0.2851" \
					"0.1434, 0.1483, 0.1606, 0.1912, 0.2952" \
					"0.1686, 0.1735, 0.1858, 0.2164, 0.3204" \
