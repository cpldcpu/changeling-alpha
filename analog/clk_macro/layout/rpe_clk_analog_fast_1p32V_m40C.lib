					"0.0909, 0.0947, 0.1040, 0.1274, 0.2070"
				) ;
			}
		}
	}
	pin(clk_slow) {
		direction : output ;
		capacitance : 0.0 ;
		max_capacitance : 0.200 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
		internal_power() {
			rise_power("scalar") { values ("88.9680") ; }
			fall_power("scalar") { values ("88.9680") ; }
		}
		timing() {
			related_pin : "en_relax" ;
			timing_sense : positive_unate ;
			cell_rise(delay_template_5x5) {
