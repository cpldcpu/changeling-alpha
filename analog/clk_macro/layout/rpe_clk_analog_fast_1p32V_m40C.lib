		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim3) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
