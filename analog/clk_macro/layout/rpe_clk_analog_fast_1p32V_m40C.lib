library(rpe_clk_analog_fast_1p32V_m40C) {
	technology (cmos) ;
	delay_model : table_lookup ;
	voltage_map (VDD, 1.32) ;
	voltage_map (VSS, 0.00) ;
	revision : 1.0.0 ;
	nom_process : 1.0 ;
	nom_temperature : -40 ;
	nom_voltage : 1.32 ;
	operating_conditions("fast_1p32V_m40C") {
		process : 1.0 ;
		temperature : -40 ;
		voltage : 1.32 ;
		tree_type : "balanced_tree" ;
	}
	default_operating_conditions : fast_1p32V_m40C ;
	default_max_transition : 1.5 ;
	default_fanout_load : 1.0 ;
	default_inout_pin_cap : 0.0 ;
	default_input_pin_cap : 0.0 ;
	default_output_pin_cap : 0.0 ;
	default_cell_leakage_power : 11.10 ;
	default_leakage_power_density : 0.0 ;
	slew_lower_threshold_pct_rise : 30 ;
	slew_upper_threshold_pct_rise : 70 ;
	input_threshold_pct_rise : 50 ;
	output_threshold_pct_rise : 50 ;
	slew_lower_threshold_pct_fall : 30 ;
	slew_upper_threshold_pct_fall : 70 ;
	input_threshold_pct_fall : 50 ;
	output_threshold_pct_fall : 50 ;
	slew_derate_from_library : 0.5 ;
	capacitive_load_unit (1, pf) ;
	voltage_unit : "1V" ;
	current_unit : "1uA" ;
	time_unit : "1ns" ;
	leakage_power_unit : "1nW" ;
	pulling_resistance_unit : "1kohm" ;
	library_features(report_delay_calculation) ;

	lu_table_template(delay_template_5x5) {
		variable_1 : input_net_transition ;
		variable_2 : total_output_net_capacitance ;
		index_1 ("0.010, 0.050, 0.150, 0.400, 1.000") ;
		index_2 ("0.002, 0.010, 0.030, 0.080, 0.250") ;
	}

cell(rpe_clk_analog) {
	area : 23495.5 ;
	dont_touch : true ;
	dont_use : true ;
	is_macro_cell : true ;
	cell_leakage_power : 11.10 ;
	pg_pin(VDD) {
		pg_type : primary_power ;
		voltage_name : VDD ;
	}
	pg_pin(VSS) {
		pg_type : primary_ground ;
		voltage_name : VSS ;
	}
	pin(en_ring) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(en_relax) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim0) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
	pin(trim1) {
		direction : input ;
		capacitance : 0.012 ;
		max_transition : 1.5 ;
		related_power_pin : VDD ;
		related_ground_pin : VSS ;
	}
