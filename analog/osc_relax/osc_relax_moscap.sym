v {xschem version=3.4.4 file_version=1.2}
G {}
K {type=subcircuit
format="@name @@VDD @@VSS @@en @@clk_slow @symname"
template="name=X1"}
V {}
S {}
E {}
L 4 -100 -40 100 -40 {}
L 4 100 -40 100 40 {}
L 4 100 40 -100 40 {}
L 4 -100 40 -100 -40 {}
T {osc_relax_moscap} 100 -55 0 1 0.25 0.25 {}
T {@name} -100 -55 0 0 0.22 0.22 {}
L 4 -120 0 -100 0 {}
B 5 -122.5 -2.5 -117.5 2.5 {name=en dir=in}
T {en} -94 -5 0 0 0.18 0.18 {}
L 4 100 0 120 0 {}
B 5 117.5 -2.5 122.5 2.5 {name=clk_slow dir=out}
T {clk_slow} 94 -5 0 1 0.18 0.18 {}
L 4 0 -60 0 -40 {}
B 5 -2.5 -62.5 2.5 -57.5 {name=VDD dir=inout}
T {VDD} 4 -28 0 0 0.16 0.16 {}
L 4 0 40 0 60 {}
B 5 -2.5 57.5 2.5 62.5 {name=VSS dir=inout}
T {VSS} 4 34 0 0 0.16 0.16 {}
